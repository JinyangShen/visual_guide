<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>guide_perception</name>
  <version>0.0.0</version>
  <description>TODO: Package description</description>
  <maintainer email="19090888115@163.com">jinyangshen</maintainer>
  <license>Apache-2.0</license>

  <depend>rclpy</depend>
  <depend>sensor_msgs</depend>
  <depend>guide_interfaces</depend>
  <!-- SLAM 定位输入（nav_msgs/Odometry） -->
  <depend>nav_msgs</depend>
  <!-- 轨迹记录（nav_msgs/Path、geometry_msgs/PoseStamped） -->
  <depend>geometry_msgs</depend>
  <!-- 决策原因码发布（std_msgs/Int32） -->
  <depend>std_msgs</depend>
  <!-- 视觉处理 -->
  <depend>cv_bridge</depend>

  <!-- launch 编排依赖 -->
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <!-- guide_system.launch.py 会启动上层提示节点 -->
  <exec_depend>guide_upper</exec_depend>
  <!-- 视觉 SLAM 建图（RDK X5 上安装 ros-humble-rtabmap-ros） -->
  <exec_depend>rtabmap_launch</exec_depend>

  <test_depend>ament_copyright</test_depend>
  <test_depend>ament_flake8</test_depend>
  <test_depend>ament_pep257</test_depend>
  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
